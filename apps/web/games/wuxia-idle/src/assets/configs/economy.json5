  // 版本与元信息
  version: '0.1.0',
  lastUpdated: '2025-09-25',

  // 金币掉落（按等级线性+波动）
  goldDrop: { basePerLevel: 2, variance: 0.3 },

  // 标准价格表（可被主题或难度覆盖）
  prices: {
    reforge: { base: 50, perAffix: 20 },
    potion_small: 10,
    cooking_firewood: 1,
    lock_item: 5,
    redeem_item: 10
  },

  // 市场默认售价表（用于当物品/材料未在其配置中指定 sellPrice 时的回退计算）
  market: {
    equipment: {
      // 稀有度基础价（单位：金币）
      baseByRarity: {
        common: 8,
        uncommon: 20,
        rare: 60,
        epic: 160
      },
      // 不同槽位的价格系数（在稀有度基础价上乘以该系数）
      slotMultiplier: {
        weapon: 2.0,
        armor: 1.6,
        offhand: 1.5,
        head: 1.2,
        belt: 1.0,
        gloves: 1.0,
        boots: 1.0,
        accessory1: 1.0,
        accessory2: 1.0,
        ring: 1.0
      }
    },
    materials: {
      // 材料按品质的单位基础价（单位：金币）
      baseByQuality: {
        common: 1,
        fine: 3,
        rare: 8,
        epic: 20,
        legendary: 50,
        mythic: 120
      }
    }
  },

  // 生活玩法收益（示例）
  lifeJobs: {
    herbGather: { min: 3, max: 8, cooldownSec: 30 }
  },
  drop: {
    defeatLoseItemChance: 0.35
  }

    "dayjs": "^1.11.10",
    "json5": "^2.2.3",
    "lodash-es": "^4.17.21",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-i18n": "^9.10.2",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.25",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vitest/ui": "^4.0.16",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.22.0",
    "fast-check": "^4.5.2",
    "jsdom": "^27.3.0",
    "prettier": "^3.2.5",
    "terser": "^5.46.0",

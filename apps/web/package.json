{
  "name": "@type-happy/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-seo.mjs && vite build && node scripts/save-shell.mjs",
    "prerender": "node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "smoke": "tsx scripts/smoke-engines.ts",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:content": "tsx scripts/validate-learning-content.ts",
    "test:content:release": "tsx scripts/validate-learning-content.ts --release",
    "test:e2e": "playwright test",
    "format:check": "prettier --check tests e2e vitest.config.ts playwright.config.ts package.json tsconfig.json scripts/prerender.mjs scripts/validate-learning-content.ts"
  },
  "dependencies": {
    "@type-happy/shared": "workspace:*",
    "@unhead/vue": "^3.4.2",
    "pinia": "^4.0.3",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/test-utils": "^2.6.0",
    "jsdom": "^31.0.1",
    "playwright": "1.64.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.11"
  }
}
